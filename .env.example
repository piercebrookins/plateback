# Server-only secrets. Never use VITE_* for credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Gemini is deliberately disabled until credentials are supplied.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Budget guard only permits priced models; total cap is hard-limited to $5.
BUILD_API_BUDGET_USD=5
LOCAL_MODEL_PATH=artifacts/models/semantic-v4/best.pt
UPLOAD_DIR=./data/uploads
# Optional override; default is data/plateback.db. Preserve this file for spending history.
# PLATEBACK_DB=./data/plateback.db
# Training device is selected with ml/train.py --device mps|cpu.
# Provider/mode is selected explicitly for each scan in the UI.
# Optional benchmark-only provider, shares the same $5 ledger.
OPENROUTER_API_KEY=
